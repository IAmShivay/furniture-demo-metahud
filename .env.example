# PostgreSQL connection string (Neon serverless, pooled).
# The app uses Drizzle ORM with the `@neondatabase/serverless` HTTP driver.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Cloudinary (product image uploads from the admin panel).
# The API secret stays on the server: the browser uploads through
# `POST /api/upload`, the API secret is never sent to the client.
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Secret used to sign the session cookie (HS256 JWT).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"
